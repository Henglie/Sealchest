# 构建产物
build/
.gradle/
.kotlin/
*.apk
*.ap_
# NDK/CMake 构建缓存
app/.cxx/
# native 验证器临时构建目录（SC_BUILD_TEST）
app/src/main/cpp/build_test/

# 调试日志
*.log

# 本机配置（含绝对路径，换机需重建）
local.properties

# IDE
.idea/
*.iml
.vs/

# 开发规范通用项
dist/
临时/
快照*/

# 第三方源码：VeraCrypt 全量克隆体积大，不入主仓库。
# 真正参与编译的 C 核心已复制进 app/src/main/cpp/veracrypt/，那部分要跟踪。
third_party/

# 工程过程文档（接手记录、修复进展、任务板），仅本地留存，不入仓库
多Agent协作.md
_commit_msg.txt
PROGRESS.md
NTFS_修复进展_0720.md

# 竞品参考代码（仅本地分析用，不入仓库）
参考/

# 临时补丁脚本 / 日志
.tmp/
.tmp_*
*.tmp

# 测试遗留的参考盘片段（非真实镜像，无代码引用）
*.vhd

# 开发期 NTFS 验证脚本（本地保留，不入仓库）
_dev_scripts/

# Python 缓存
__pycache__/

# 本地测试容器 / 中间产物（下划线前缀 = 本机专用）
_xcs3_local/

# 本机启动器脚本
*.cmd

# 签名密钥与凭据（绝不入仓库；丢失无法给已发布 app 出更新，须离线妥善备份）
*.keystore
*.jks
keystore.properties
